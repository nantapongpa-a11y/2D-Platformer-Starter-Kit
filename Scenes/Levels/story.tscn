[node name="StoryText" type="Label" parent="Parchment"]
offset_left = -390.0
offset_top = -200.0
offset_right = 390.0
offset_bottom = 205.0
theme = ExtResource("3_theme")
theme_override_colors/font_color = Color(0.29, 0.16, 0.06, 1)
theme_override_constants/outline_size = 0
theme_override_constants/line_spacing = 2
theme_override_font_sizes/font_size = 21
text = "ณ หมู่เกาะมุกกลางทะเลคราม มี \"ไข่มุกแห่งท้องทะเล\"
คอยปกป้องทุกเกาะจากพายุร้าย
คืนหนึ่ง \"กัปตันฉลามดำ\" จอมโจรสลัดผู้โหดเหี้ยม
บุกขโมยไข่มุกไปซ่อนไว้ในถ้ำสมบัติ
แล้วปล่อยโจรสลัด ปู และโครงกระดูก ออกอาละวาดทั่วทะเล

\"กัปตันโก้\" นักเดินเรือผู้กล้าหาญ คว้าดาบคลื่นทะเลคู่ใจ
ออกเดินทางผ่าน 4 ด่าน เพื่อนำไข่มุกกลับคืนสู่หมู่เกาะ!
หาดเกาะมุก → ท่าเรือโจรสลัด → เรือโจรสลัด → ถ้ำสมบัติ

A / D เดิน   •   Space กระโดด 2 ชั้น   •   X ฟันคลื่นน้ำ"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

